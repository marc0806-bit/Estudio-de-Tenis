tabla_caja <- stack(tenis2[, c("Winner_rank", "Loser_rank")])
ggplot(tabla_caja, aes(x = ind, y = values, fill = ind)) +
geom_boxplot(alpha = 0.8) +
scale_fill_manual(values = c("blue2", "darkorange"), labels = c("Ganador", "Perdedor")) +
labs(title = "Distribución de Rankings", x = "", y = "Posición ATP")
